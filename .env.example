# ==============================
# SilaiKaam — Environment Config
# Copy to .env and fill in values. Never commit .env with real secrets.
# ==============================

# General
NODE_ENV=development

# PostgreSQL
# Uses a dedicated database/user on your local PostgreSQL instance, isolated
# from any other databases on the same server (e.g. loc_db).
POSTGRES_USER=silaikaam_user
POSTGRES_PASSWORD=changeme
POSTGRES_DB=silaikaam_db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://silaikaam_user:changeme@localhost:5432/silaikaam_db?schema=public

# RabbitMQ
RABBITMQ_USER=silaikaam
RABBITMQ_PASSWORD=silaikaam
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://silaikaam:silaikaam@localhost:5672

# API Gateway
API_PORT=3001
API_HOST=0.0.0.0
WEB_APP_URL=http://localhost:3000

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Microservices (local ports)
IDENTITY_SERVICE_PORT=3101
IDENTITY_SERVICE_URL=http://localhost:3101
USER_SERVICE_PORT=3102
USER_SERVICE_URL=http://localhost:3102
SHOP_SERVICE_PORT=3103
CATALOG_SERVICE_PORT=3104
CATALOG_SERVICE_URL=http://localhost:3104
ORDER_SERVICE_PORT=3105
ORDER_SERVICE_URL=http://localhost:3105
FITTING_SERVICE_PORT=3106
FITTING_SERVICE_URL=http://localhost:3106
ASSIGNMENT_SERVICE_PORT=3107
PRICING_SERVICE_PORT=3108
NOTIFICATION_SERVICE_PORT=3109
ADMIN_SERVICE_PORT=3110

# Auth — required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Logging
LOG_LEVEL=debug
