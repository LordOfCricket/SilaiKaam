# ==============================
# SilaiKaam — Environment Config
# Copy to .env and fill in values. Never commit .env with real secrets.
# ==============================

# General
NODE_ENV=development

# PostgreSQL
# Host port defaults to 5433 (not 5432) to avoid colliding with a locally installed Postgres.
POSTGRES_USER=silaikaam
POSTGRES_PASSWORD=silaikaam
POSTGRES_DB=silaikaam
POSTGRES_PORT=5433
DATABASE_URL=postgresql://silaikaam:silaikaam@localhost:5433/silaikaam?schema=public

# RabbitMQ
RABBITMQ_USER=silaikaam
RABBITMQ_PASSWORD=silaikaam
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_URL=amqp://silaikaam:silaikaam@localhost:5672

# API Gateway
API_PORT=3001
API_HOST=0.0.0.0

# Web
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001

# Microservices (local ports, placeholders for future use)
IDENTITY_SERVICE_PORT=3101
USER_SERVICE_PORT=3102
SHOP_SERVICE_PORT=3103
CATALOG_SERVICE_PORT=3104
ORDER_SERVICE_PORT=3105
FITTING_SERVICE_PORT=3106
ASSIGNMENT_SERVICE_PORT=3107
PRICING_SERVICE_PORT=3108
NOTIFICATION_SERVICE_PORT=3109
ADMIN_SERVICE_PORT=3110

# Auth (placeholders — not implemented in this phase)
JWT_SECRET=
JWT_EXPIRES_IN=

# Logging
LOG_LEVEL=debug
