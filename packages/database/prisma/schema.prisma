// Base Prisma schema for SilaiKaam.
// Domain models are added incrementally, phase by phase. Currently covers:
// identity (User/Role) and the customer profile + address foundation.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  TAILOR
  FITTING_EXPERT
  SHOP_OWNER
  STAFF
  SUPER_ADMIN
}

/// Owned by identity-service. Authentication credentials + role only —
/// no profile data lives here.
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  role         Role     @default(CUSTOMER)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  customerProfile CustomerProfile?

  @@map("users")
}

enum FitPreferenceType {
  SLIM
  REGULAR
  RELAXED
  CUSTOM
}

enum MeasurementKey {
  CHEST
  WAIST
  SHOULDER
  SLEEVE
  ARMHOLE
  SHIRT_LENGTH
  TROUSER_WAIST
  HIP
  INSEAM
  OUTSEAM
  THIGH
  KNEE
}

/// Owned by user-service. One-to-one with User, created alongside it at
/// registration time.
model CustomerProfile {
  id          String    @id @default(uuid())
  userId      String    @unique
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  fullName    String
  phone       String?
  dateOfBirth DateTime?
  gender      String?
  avatarUrl   String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  addresses      Address[]
  fitProfiles    FitProfile[]
  cart           Cart?
  orders         Order[]
  wishlistItems  WishlistItem[]
  notifications  Notification[]
  supportTickets SupportTicket[]

  @@map("customer_profiles")
}

/// Owned by user-service. V1 UX exposes a single active fit profile per
/// customer, but the model is one-to-many so a later batch can offer
/// multiple named profiles (e.g. "Shirts", "Formal") without a migration.
model FitProfile {
  id                String            @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile   @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  label             String
  fitPreference     FitPreferenceType @default(REGULAR)
  notes             String?
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  measurements             FitMeasurement[]
  cartItems                CartItem[]
  existingGarmentRequests  ExistingGarmentRequest[]
  customStitchingRequests  CustomStitchingRequest[]

  @@index([customerProfileId])
  @@map("fit_profiles")
}

/// One row per measured body part. Sparse by design — only the
/// measurements a customer actually enters exist, nothing is required
/// up front, and new MeasurementKey values can be added later.
model FitMeasurement {
  id           String         @id @default(uuid())
  fitProfileId String
  fitProfile   FitProfile     @relation(fields: [fitProfileId], references: [id], onDelete: Cascade)
  key          MeasurementKey
  value        Float
  unit         String         @default("in")
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  @@unique([fitProfileId, key])
  @@map("fit_measurements")
}

/// Owned by user-service. Addresses are soft-deleted (isActive) rather than
/// removed, so a future Order can keep referencing/snapshotting the address
/// that was current at order time without that history disappearing.
model Address {
  id                String   @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  label             String?
  line1             String
  line2             String?
  city              String
  state             String
  postalCode        String
  country           String   @default("IN")
  isDefault         Boolean  @default(false)
  isActive          Boolean  @default(true)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([customerProfileId])
  @@map("addresses")
}

enum ProductAvailability {
  IN_STOCK
  OUT_OF_STOCK
  PREORDER
}

/// Owned by catalog-service. Customer-facing discovery only in this batch —
/// no shop-owner management endpoints exist yet.
model Category {
  id        String    @id @default(uuid())
  name      String
  slug      String    @unique
  isActive  Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  products        Product[]
  fittingServices FittingServiceCategory[]

  @@map("categories")
}

model Product {
  id                String              @id @default(uuid())
  categoryId        String
  category          Category            @relation(fields: [categoryId], references: [id])
  name              String
  slug              String              @unique
  description       String?
  price             Float
  discountPrice     Float?
  currency          String              @default("INR")
  imageUrl          String?
  availability      ProductAvailability @default(IN_STOCK)
  sizes             String[]            @default([])
  colors            String[]            @default([])
  // Data-driven Buy + Fit eligibility (Phase 8) — never inferred client-side.
  isFittingEligible Boolean             @default(false)
  isActive          Boolean             @default(true)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  variants      ProductVariant[]
  cartItems     CartItem[]
  wishlistItems WishlistItem[]

  @@index([categoryId])
  @@map("products")
}

/// A concrete, purchasable size/color combination with its own stock and
/// optional price override. A product with no variant rows is treated by
/// the API as a single implicit variant using the product's own
/// price/availability (kept for compatibility with Batch 2 listings).
model ProductVariant {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  price     Float?
  stock     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cartItems CartItem[]

  @@unique([productId, size, color])
  @@index([productId])
  @@map("product_variants")
}

enum FittingServiceType {
  SLEEVE_ALTERATION
  LENGTH_ALTERATION
  WAIST_ALTERATION
  CHEST_ALTERATION
  SHOULDER_ALTERATION
  TAPERING
}

/// Owned by catalog-service. `basePrice` is nullable on purpose: no pricing
/// service exists yet, so it stays null until one populates it — the API
/// reports "pricing unavailable" rather than a fabricated fee.
model FittingService {
  id                   String             @id @default(uuid())
  type                 FittingServiceType @unique
  name                 String
  description          String?
  requiredMeasurements MeasurementKey[]
  basePrice            Float?
  isActive             Boolean            @default(true)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  categories FittingServiceCategory[]

  @@map("fitting_services")
}

/// Which garment categories a fitting service applies to — lets the
/// customer-facing product page show only relevant services.
model FittingServiceCategory {
  id               String         @id @default(uuid())
  fittingServiceId String
  fittingService   FittingService @relation(fields: [fittingServiceId], references: [id], onDelete: Cascade)
  categoryId       String
  category         Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([fittingServiceId, categoryId])
  @@map("fitting_service_categories")
}

enum GarmentCondition {
  NEW
  GOOD
  WORN
  DAMAGED
}

enum GarmentPhotoRole {
  FRONT
  BACK
  AREA
  DAMAGE
  READY_PROOF
  ACTION_RESPONSE
}

/// Owned by fitting-service. A customer's request to have a garment they
/// already own altered. Media is stored inline as base64 (no cloud storage
/// provider exists yet) and served only through an ownership-gated
/// endpoint — never exposed publicly.
model ExistingGarmentRequest {
  id                String           @id @default(uuid())
  customerProfileId String
  garmentType       String
  brand             String?
  currentSize       String?
  condition         GarmentCondition
  notes             String?
  fitProfileId      String?
  fitProfile        FitProfile?      @relation(fields: [fitProfileId], references: [id])
  selectedFittingServiceIds String[] @default([])
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  photos   GarmentPhoto[]
  cartItem CartItem?

  @@index([customerProfileId])
  @@map("existing_garment_requests")
}

/// `requestId` and `fittingWorkflowId` are both optional so this one model
/// can serve garment-inspection photos (Existing Garment) AND fitting-
/// workflow photos (ready-garment proof, customer action-required
/// responses) without a second media table. Exactly one is set per row.
model GarmentPhoto {
  id                String                  @id @default(uuid())
  requestId         String?
  request           ExistingGarmentRequest? @relation(fields: [requestId], references: [id], onDelete: Cascade)
  fittingWorkflowId String?
  fittingWorkflow   FittingWorkflow?        @relation(fields: [fittingWorkflowId], references: [id], onDelete: Cascade)
  role              GarmentPhotoRole
  mimeType          String
  dataBase64        String
  sizeBytes         Int
  createdAt         DateTime                @default(now())

  @@index([fittingWorkflowId])
  @@map("garment_photos")
}

/// Owned by fitting-service. A request for a brand-new, made-to-order
/// garment. `basePrice`-style pricing doesn't exist for this journey yet —
/// it is always "quote required" until a future pricing/quote workflow
/// attaches a real price.
model CustomStitchingRequest {
  id                  String      @id @default(uuid())
  customerProfileId   String
  garmentType         String
  fabricDetails       String?
  designDetails       String?
  color               String?
  specialRequirements String?
  notes               String?
  fitProfileId        String?
  fitProfile          FitProfile? @relation(fields: [fitProfileId], references: [id])
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt

  referenceImages CustomStitchingReferenceImage[]
  cartItem        CartItem?

  @@index([customerProfileId])
  @@map("custom_stitching_requests")
}

model CustomStitchingReferenceImage {
  id         String                  @id @default(uuid())
  requestId  String
  request    CustomStitchingRequest  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  mimeType   String
  dataBase64 String
  sizeBytes  Int
  createdAt  DateTime                @default(now())

  @@map("custom_stitching_reference_images")
}

/// Owned by order-service. One cart per customer, created lazily on first
/// add. Cart items never cache price/stock — every read re-validates them
/// live against the owning tables so the cart can never drift from reality.
model Cart {
  id                String          @id @default(uuid())
  customerProfileId String          @unique
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  items CartItem[]

  @@map("carts")
}

enum CartItemType {
  PRODUCT_ONLY
  BUY_FIT
  EXISTING_GARMENT
  CUSTOM_STITCHING
}

/// A discriminated union, not an ambiguous blob: `type` says which journey
/// this row represents, and only that journey's fields are populated. Every
/// reference is a real FK validated against its owning table — never a
/// loose string/JSON blob — so each configuration stays unambiguous.
model CartItem {
  id     String       @id @default(uuid())
  cartId String
  cart   Cart         @relation(fields: [cartId], references: [id], onDelete: Cascade)
  type   CartItemType

  // PRODUCT_ONLY / BUY_FIT
  productId String?
  product   Product?        @relation(fields: [productId], references: [id])
  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])
  quantity  Int?

  // BUY_FIT only
  fitProfileId              String?
  fitProfile                FitProfile? @relation(fields: [fitProfileId], references: [id])
  selectedFittingServiceIds String[]    @default([])
  notes                     String?

  // EXISTING_GARMENT
  existingGarmentRequestId String?                 @unique
  existingGarmentRequest   ExistingGarmentRequest? @relation(fields: [existingGarmentRequestId], references: [id], onDelete: Cascade)

  // CUSTOM_STITCHING
  customStitchingRequestId String?                 @unique
  customStitchingRequest   CustomStitchingRequest? @relation(fields: [customStitchingRequestId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([cartId])
  @@map("cart_items")
}

enum OrderItemType {
  PRODUCT_ONLY
  PRODUCT_WITH_FITTING
  EXISTING_GARMENT_FITTING
  CUSTOM_STITCHING
}

enum PaymentState {
  PENDING
  SUCCESS
  FAILED
  CANCELLED
  REFUNDED
}

enum OrderStatus {
  PLACED
  CONFIRMED
  PREPARING
  FITTING
  QUALITY_CHECK
  READY
  PREPARING_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERED
  COMPLETED
  CANCELLED
  DELIVERY_FAILED
  DELIVERY_RESCHEDULED
}

/// Owned by order-service. Created once, atomically, from a validated Cart.
/// Holds only aggregates — every historical fact a customer needs to see
/// again lives in OrderItem/OrderAddressSnapshot so later Product/FitProfile
/// /Address/pricing changes can never rewrite what was actually ordered.
model Order {
  id                String       @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id])
  status            OrderStatus  @default(PLACED)
  paymentState      PaymentState @default(PENDING)
  /// Client-supplied once per checkout attempt and re-sent on retry so a
  /// double "Place Order" click (or a client-side retry after a dropped
  /// response) can never create two orders — enforced by the unique index,
  /// not just an application-level check.
  idempotencyKey    String       @unique
  productSubtotal   Float        @default(0)
  fittingSubtotal   Float        @default(0)
  discountTotal     Float        @default(0)
  total             Float        @default(0)
  hasUnpricedItems  Boolean      @default(false)
  /// Set only when this order was created via a "Buy Again"/"Repeat Fit"
  /// action — purely for customer-facing traceability. The original order
  /// is never mutated or duplicated; this just links to it.
  reorderedFromOrderId String?
  reorderedFromOrder   Order?   @relation("OrderReorders", fields: [reorderedFromOrderId], references: [id])
  reorders             Order[]  @relation("OrderReorders")
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  items           OrderItem[]
  addressSnapshot OrderAddressSnapshot?
  statusHistory   OrderStatusHistory[]
  reviews         Review[]
  cancellation    OrderCancellation?
  refunds         Refund[]
  disputes        Dispute[]

  @@index([customerProfileId])
  @@map("orders")
}

/// An immutable copy of the delivery address at order time. Never updated
/// when the customer edits/removes the underlying Address later.
model OrderAddressSnapshot {
  id         String   @id @default(uuid())
  orderId    String   @unique
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  label      String?
  line1      String
  line2      String?
  city       String
  state      String
  postalCode String
  country    String
  createdAt  DateTime @default(now())

  @@map("order_address_snapshots")
}

/// One row per cart item converted at checkout. Every field here is a
/// snapshot taken at order time — never a live join to Product/FitProfile/
/// FittingService, so those can change freely afterward without altering
/// order history.
model OrderItem {
  id      String        @id @default(uuid())
  orderId String
  order   Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  type    OrderItemType

  // PRODUCT_ONLY / PRODUCT_WITH_FITTING
  productId      String?
  productName    String?
  variantId      String?
  variantSize    String?
  variantColor   String?
  quantity       Int?
  unitPrice      Float?
  discountAmount Float?

  // PRODUCT_WITH_FITTING only
  fitProfileId              String?
  fitProfileLabel           String?
  fitPreference             String?
  measurementsSnapshot      Json?
  fittingServicesSnapshot   Json?
  notes                     String?

  // EXISTING_GARMENT_FITTING
  existingGarmentRequestId String?
  garmentType              String?
  garmentCondition         String?
  garmentBrand             String?
  garmentPhotoCount        Int?

  // CUSTOM_STITCHING
  customStitchingRequestId String?
  fabricDetails            String?
  designDetails            String?

  lineTotal Float?
  createdAt DateTime @default(now())

  fittingWorkflow FittingWorkflow?
  reviews         Review[]

  @@index([orderId])
  @@map("order_items")
}

/// Append-only — reconstructs the customer-facing timeline. Only ever
/// written by order-service; no staff/tailor identity is ever stored here.
model OrderStatusHistory {
  id          String      @id @default(uuid())
  orderId     String
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status      OrderStatus
  note        String?
  actorSource String?
  createdAt   DateTime    @default(now())

  @@index([orderId])
  @@map("order_status_history")
}

enum FittingWorkflowStatus {
  RECEIVED
  INSPECTION
  ACTION_REQUIRED
  ASSIGNED
  IN_PROGRESS
  QC
  REWORK_REQUIRED
  READY
  COMPLETED
  REJECTED
  CANCELLED
}

enum InspectionOutcome {
  PASS
  ACTION_REQUIRED
  REJECTED
  REWORK_REQUIRED
}

enum InspectionStage {
  PRE_FITTING
  QC
}

enum ActionRequestStatus {
  PENDING
  SUBMITTED
  EXPIRED
}

/// Owned by fitting-service. The internal operational lifecycle for one
/// fitting-eligible OrderItem (PRODUCT_WITH_FITTING or
/// EXISTING_GARMENT_FITTING) — one row per item, created once at order
/// placement and never duplicated (`orderItemId` is unique). Customer-safe
/// status/messages are always derived from `status` via a mapping, never
/// exposed as this internal enum directly.
model FittingWorkflow {
  id                String                @id @default(uuid())
  orderId           String
  orderItemId       String                @unique
  orderItem         OrderItem             @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  customerProfileId String
  itemType          OrderItemType
  status            FittingWorkflowStatus @default(RECEIVED)
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt

  statusHistory  FittingStatusHistory[]
  inspections    FittingInspection[]
  actionRequests FittingActionRequest[]
  readyPhotos    GarmentPhoto[]

  @@index([orderId])
  @@index([customerProfileId])
  @@map("fitting_workflows")
}

/// Append-only. `customerMessage` is the only text ever shown to the
/// customer; `actorSource` records where the change came from (e.g.
/// "SYSTEM", "STAFF") — never a staff member's identity.
model FittingStatusHistory {
  id                String                @id @default(uuid())
  fittingWorkflowId String
  fittingWorkflow   FittingWorkflow       @relation(fields: [fittingWorkflowId], references: [id], onDelete: Cascade)
  status            FittingWorkflowStatus
  customerMessage   String?
  actorSource       String
  createdAt         DateTime              @default(now())

  @@index([fittingWorkflowId])
  @@map("fitting_status_history")
}

/// `observations`/`issues` are internal-only fields — never returned by a
/// customer-facing endpoint.
/// `stage` distinguishes the pre-fitting garment inspection from the
/// post-fitting QC check — same shape, same privacy rules (observations/
/// issues never reach the customer), reused rather than duplicated.
model FittingInspection {
  id                     String            @id @default(uuid())
  fittingWorkflowId      String
  fittingWorkflow        FittingWorkflow   @relation(fields: [fittingWorkflowId], references: [id], onDelete: Cascade)
  stage                  InspectionStage   @default(PRE_FITTING)
  outcome                InspectionOutcome
  garmentCondition       GarmentCondition?
  observations           String?
  issues                 String?
  requiresCustomerAction Boolean           @default(false)
  actorSource            String
  createdAt              DateTime          @default(now())

  @@index([fittingWorkflowId])
  @@map("fitting_inspections")
}

/// `requestedInfo` is customer-safe text describing what's needed.
model FittingActionRequest {
  id                   String              @id @default(uuid())
  fittingWorkflowId    String
  fittingWorkflow      FittingWorkflow     @relation(fields: [fittingWorkflowId], references: [id], onDelete: Cascade)
  status               ActionRequestStatus @default(PENDING)
  requestedInfo        String
  customerResponseText String?
  respondedAt          DateTime?
  expiresAt            DateTime?
  createdAt            DateTime            @default(now())

  @@index([fittingWorkflowId])
  @@index([status])
  @@map("fitting_action_requests")
}

enum ReviewTargetType {
  PRODUCT
  FITTING
  CUSTOM_STITCHING
}

/// Owned by order-service. One row per (orderItem, targetType) — a
/// PRODUCT_WITH_FITTING item can get both a PRODUCT review and a FITTING
/// review. Eligibility (order completed, item actually purchased, fitting
/// actually completed) is derived entirely server-side from Order/OrderItem
/// /FittingWorkflow — never from client input.
model Review {
  id                String           @id @default(uuid())
  customerProfileId String
  orderId           String
  order             Order            @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId       String
  orderItem         OrderItem        @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  targetType        ReviewTargetType
  rating            Int
  title             String?
  comment           String?
  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt

  @@unique([orderItemId, targetType])
  @@index([customerProfileId])
  @@index([orderId])
  @@map("reviews")
}

/// Owned by user-service. A reference to the CURRENT product only — never a
/// price/availability snapshot. If the product changes or is removed, the
/// wishlist keeps pointing at it and the UI reflects the current (possibly
/// unavailable) state honestly.
model WishlistItem {
  id                String          @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  productId         String
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([customerProfileId, productId])
  @@index([customerProfileId])
  @@index([productId])
  @@map("wishlist_items")
}

enum NotificationType {
  ORDER_PLACED
  ORDER_STATUS_CHANGED
  FITTING_ACTION_REQUIRED
  FITTING_PROGRESS
  QC_PASSED
  REWORK_REQUIRED
  READY_FOR_DELIVERY
  OUT_FOR_DELIVERY
  DELIVERY_FAILED
  DELIVERY_RESCHEDULED
  ORDER_DELIVERED
  ORDER_COMPLETED
  REVIEW_AVAILABLE
  CANCELLATION_CONFIRMED
  REFUND_REQUESTED
  REFUND_PROCESSING
  REFUND_COMPLETED
  REFUND_FAILED
  DISPUTE_OPENED
  DISPUTE_UPDATED
  DISPUTE_RESOLVED
  REWORK_REQUESTED
}

/// Owned by user-service for the customer-facing read/list surface, but
/// written directly by order-service/fitting-service at the meaningful
/// event points — the same shared-DB, no-HTTP-hop precedent used
/// throughout this app (e.g. order-service writing FittingWorkflow rows).
/// `relatedOrderId`/`relatedOrderItemId` are plain indexed references, not
/// FKs, matching how other cross-bounded-context ids are stored here.
/// `dedupeKey` gives idempotent creation for free via its unique index.
model Notification {
  id                 String           @id @default(uuid())
  customerProfileId  String
  customerProfile    CustomerProfile  @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  type               NotificationType
  title              String
  message            String
  relatedOrderId     String?
  relatedOrderItemId String?
  dedupeKey          String           @unique
  isRead             Boolean          @default(false)
  readAt             DateTime?
  createdAt          DateTime         @default(now())

  @@index([customerProfileId, createdAt])
  @@index([customerProfileId, isRead])
  @@map("notifications")
}

enum SupportCategory {
  ORDER
  FITTING
  DELIVERY
  PRODUCT
  ACCOUNT
  OTHER
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_FOR_CUSTOMER
  RESOLVED
  CLOSED
}

enum SupportSenderType {
  CUSTOMER
  SUPPORT
}

/// `orderId` is a plain indexed reference (validated against order-service's
/// Order table at write time, same shared-DB precedent as elsewhere) — not
/// an FK, since Support and Order are different bounded contexts.
model SupportTicket {
  id                String              @id @default(uuid())
  customerProfileId String
  customerProfile   CustomerProfile     @relation(fields: [customerProfileId], references: [id], onDelete: Cascade)
  orderId           String?
  category          SupportCategory
  subject           String
  description       String
  status            SupportTicketStatus @default(OPEN)
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  closedAt          DateTime?

  messages SupportMessage[]

  @@index([customerProfileId, status])
  @@index([customerProfileId, createdAt])
  @@index([orderId])
  @@map("support_tickets")
}

/// `senderType` is all the UI ever shows for SUPPORT messages — no staff
/// identity is ever stored or exposed.
model SupportMessage {
  id         String            @id @default(uuid())
  ticketId   String
  ticket     SupportTicket     @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  senderType SupportSenderType
  message    String
  createdAt  DateTime          @default(now())

  @@index([ticketId])
  @@map("support_messages")
}

enum CancellationReason {
  CUSTOMER_CHANGED_MIND
  ORDERED_BY_MISTAKE
  DELIVERY_TOO_LATE
  WRONG_ITEM
  OTHER
}

/// Owned by order-service. Order-level only (V1 policy — see
/// CancellationService: an Order is created/decremented as one atomic
/// unit, so partial/item cancellation would need a larger redesign).
/// `orderId` is unique — at most one cancellation per order, which is also
/// the idempotency guard against a duplicate/racing request.
model OrderCancellation {
  id                String             @id @default(uuid())
  orderId           String             @unique
  order             Order              @relation(fields: [orderId], references: [id], onDelete: Cascade)
  customerProfileId String
  reason            CancellationReason
  note              String?
  createdAt         DateTime           @default(now())

  @@index([customerProfileId])
  @@map("order_cancellations")
}

enum RefundStatus {
  PENDING
  PROCESSING
  SUCCEEDED
  FAILED
  CANCELLED
}

/// Owned by order-service. Records what SHOULD be refunded — no real
/// payment provider exists yet, so `status` only ever reaches PENDING from
/// customer-facing flows in this batch; PROCESSING/SUCCEEDED/FAILED exist
/// so the model is complete once a real provider is wired in, and are only
/// reachable via the internal ops endpoint (never a customer action).
/// `sourceCancellationId`/`sourceDisputeId` are unique — at most one refund
/// per triggering event, which is the idempotency guard.
model Refund {
  id                    String       @id @default(uuid())
  orderId               String
  order                 Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId           String?
  customerProfileId     String
  amount                Decimal      @db.Decimal(10, 2)
  currency              String       @default("INR")
  reason                String
  status                RefundStatus @default(PENDING)
  sourceCancellationId  String?      @unique
  sourceDisputeId       String?      @unique
  externalReference     String?
  createdAt             DateTime     @default(now())
  updatedAt             DateTime     @updatedAt
  processedAt           DateTime?

  @@index([customerProfileId])
  @@index([orderId])
  @@map("refunds")
}

enum DisputeType {
  FIT_ISSUE
  DAMAGED_ITEM
  WRONG_ITEM
  MISSING_ITEM
  QUALITY_ISSUE
  DELIVERY_ISSUE
  OTHER
}

enum DisputeStatus {
  OPEN
  UNDER_REVIEW
  ACTION_REQUIRED
  RESOLVED
  REJECTED
  CLOSED
}

/// Owned by order-service. Structured business data distinct from
/// SupportTicket (communication) — customers discuss a dispute through the
/// existing Support system rather than a duplicated messaging model.
/// `resolution` is customer-safe summary text only; no internal notes.
model Dispute {
  id                String        @id @default(uuid())
  customerProfileId String
  orderId           String
  order             Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderItemId       String?
  type              DisputeType
  description       String
  status            DisputeStatus @default(OPEN)
  resolution        String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  resolvedAt        DateTime?

  @@index([customerProfileId])
  @@index([orderId])
  @@index([status])
  @@map("disputes")
}
