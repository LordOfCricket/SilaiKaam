{
  "name": "silaikaam",
  "version": "0.1.0",
  "private": true,
  "description": "SilaiKaam monorepo",
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@12.4.1",
  "scripts": {
    "dev": "pnpm -r --parallel --filter=./apps/* --filter=./services/* run dev",
    "build": "pnpm -r --filter=./apps/* --filter=./services/* --filter=./packages/* run --if-present build",
    "lint": "pnpm -r run --if-present lint",
    "typecheck": "pnpm -r run --if-present typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,yml,yaml}\" --ignore-path .gitignore",
    "test": "pnpm -r run --if-present test",
    "clean": "pnpm -r run --if-present clean",
    "prepare": "pnpm --filter \"./packages/*\" run build",
    "docker:up": "docker compose up -d",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f",
    "db:generate": "pnpm --filter @silaikaam/database run generate",
    "db:migrate": "pnpm --filter @silaikaam/database run migrate"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "prettier": "^3.3.3",
    "rimraf": "^6.1.3",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.70.0"
  }
}
